# Photo Organizer - Frontend Production Environment Template
# Copy this file to frontend/.env.production and set the private backend origin.
# Do NOT commit frontend/.env.production -- it is listed in .gitignore.

# Server-only origin reachable by the Next.js process. The browser uses only
# same-origin /api/* and /media/* paths and never receives this value.
# Supply the environment-specific private origin at process/container runtime.
BACKEND_INTERNAL_BASE_URL=http://backend:8001
