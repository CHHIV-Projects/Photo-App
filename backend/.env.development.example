# =============================================================================
# Photo Organizer - Development Environment Template
# =============================================================================
# Copy this file to backend/.env.development for local development overrides.
# Do NOT commit backend/.env.development -- it is listed in .gitignore.
#
# This file is optional. If backend/.env.development does not exist, the
# backend will fall back to backend/.env (legacy behavior).
#
# If you have local secrets (e.g. GOOGLE_MAPS_API_KEY) in backend/.env,
# copy them here when you migrate to the .env.development model.
# =============================================================================

# Runtime profile
APP_RUNTIME_PROFILE=development

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=photo_organizer
POSTGRES_USER=photo_user
POSTGRES_PASSWORD=change_me

# =============================================================================
# Cache (Redis)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# Storage Paths
# =============================================================================
# Relative paths are resolved from the backend directory.
# local: disposable Development storage; never requires NAS.
# nas: requires NAS_MOUNT_PATH, an active mount, the marker below, and every
# configured directory. NAS mode never falls back to local storage.
STORAGE_MODE=local
STORAGE_ROOT=../storage
DROP_ZONE_PATH=../storage/drop_zone
VAULT_PATH=../storage/vault
QUARANTINE_PATH=../storage/quarantine
INGEST_FAILURES_PATH=../storage/ingest_failures
PREVIEWS_PATH=../storage/previews
THUMBNAILS_PATH=../storage/thumbnails
REVIEW_PATH=../storage/review
LOGS_PATH=../storage/logs
REPORTS_PATH=../storage/logs
EXPORTS_ICLOUD_PATH=../storage/exports/icloud
MODEL_CACHE_PATH=../storage/models

# Required only for STORAGE_MODE=nas. Do not create the marker automatically.
NAS_MOUNT_PATH=
NAS_ENVIRONMENT_MARKER=.photo-organizer-environment
NAS_ENVIRONMENT_MARKER_VALUE=environment=development

# YuNet is provisioned by backend/scripts/provision_yunet_model.py.
MODEL_ROOT_PATH=app/services/vision/models
FACE_MODEL_PATH=app/services/vision/models/face_detection_yunet_2023mar.onnx

# =============================================================================
# Backend Server
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# =============================================================================
# Frontend / CORS
# =============================================================================
FRONTEND_PORT=3000
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# =============================================================================
# External APIs
# =============================================================================
# Copy from backend/.env or set your own local value.
GOOGLE_MAPS_API_KEY=
