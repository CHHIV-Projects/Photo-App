# Copy to docker/.env.development on the Linux Development host.
# Do not commit that secret-bearing file.
COMPOSE_PROJECT_NAME=photo-organizer-dev
POSTGRES_DB=photo_organizer_dev
POSTGRES_USER=photo_user
POSTGRES_PASSWORD=
DEVELOPMENT_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=18001
FRONTEND_HOST_PORT=13000
BACKEND_INTERNAL_BASE_URL=http://backend:8001
FRONTEND_ALLOWED_ORIGINS=http://127.0.0.1:13000,http://localhost:13000
# Nonsecret numeric GIDs resolved on the approved host after Source-access installation.
SOURCE_ACCESS_SOCKET_GID=
SOURCE_ACCESS_DATA_GID=
